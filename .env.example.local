NEXT_PUBLIC_parseAppId=your_parse_app_id
NEXT_PUBLIC_parseJavascriptKey=your_parse_javascript_key
NEXT_PUBLIC_parseServerUrl=http://localhost:1337/parse

NEXT_PUBLIC_taskyUrlApi=https://your-tasky-instance.herokuapp.com/
NEXT_PUBLIC_PUENTE_SMS_EMAIL_API_URL=http://your-sms-email-service-url
NEXT_PUBLIC_PUENTE_DATA_EXPORTER_API_URL=http://your-data-exporter-url/
NEXT_PUBLIC_PUENTE_ANALYTICS_DASHBOARD_URL=http://your-analytics-dashboard-url/
NEXT_PUBLIC_PUENTE_REST_ETL_URL=http://your-rest-etl-url/

# --- AI Data Assistant (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
# Required: OpenAI key the agent uses to call the model.
OPENAI_API_KEY=sk-your-openai-key
# Optional: override the model (defaults to gpt-4.1-mini).
AGENT_MODEL=gpt-4.1-mini
# Optional: only needed to run `yarn eval` (Braintrust eval suite).
BRAINTRUST_API_KEY=your_braintrust_key
