    "react-beautiful-dnd": "^13.0.0",
    "react-csv": "^2.2.2",
    "react-dom": "17",
    "react-hook-form": "^6.6.0",
    "react-image-lightbox": "^5.1.4",
    "react-native-web": "^0.14.13",
    "react-popper": "^2.3.0",
    "react-scroll-parallax": "^2.4.0",
    "react-scrollspy": "^3.4.3",
    "react-wow": "^1.0.0",
    "react-youtube": "^7.13.1",
