  "scripts": {
    "test": "jest --watchAll=false",
    "test:integration": "jest --config jest.integration.config.js",
    "test:watch": "jest --watch",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next build && next export",
    "reinstall": "rm yarn.lock && rm -rf node_modules/ && yarn install",
    "release": "standard-version",
    "lint": "next lint",
    "lint:e2e": "eslint e2e scripts --ext .mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:fix": "next lint --fix",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:css:baseline": "node scripts/lint-css.mjs --update",
    "test-storybook": "storybook build --quiet && concurrently -k -s first -n sb,test \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "test-storybook:dev": "test-storybook --url http://localhost:6006"
  },
